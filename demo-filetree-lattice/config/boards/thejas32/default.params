# freertrtos default parameters for the THEJAS32 reference board.
# One parameter per line: NAME VALUE
# The on-board shell can override these at runtime; `param save` persists them.

# --- System ---------------------------------------------------------------
MAV_SYS_ID              1
MAV_COMP_ID             1
MAV_GCS_TIMEOUT_MS      5000
COM_ARM_AUTH            0
COM_DISARM_LAND         3.0
COM_LOW_BAT_ACT         2

# --- Sensors and estimator ------------------------------------------------
SENS_IMU_RATE_HZ        1000
SENS_BARO_RATE_HZ       50
SENS_MAG_RATE_HZ        100
SENS_GPS_RATE_HZ        10
EKF_ATT_NOISE           0.05
EKF_POS_NOISE           0.20

# --- Attitude / position control -----------------------------------------
MC_ROLLRATE_P           0.15
MC_ROLLRATE_I           0.02
MC_ROLLRATE_D           0.002
MC_PITCHRATE_P          0.15
MC_PITCHRATE_I          0.02
MC_PITCHRATE_D          0.002
MC_YAWRATE_P            0.20
MC_YAWRATE_I            0.03
MC_YAWRATE_D            0.000
MC_ATT_P                6.0
MC_ATT_YAW_P            2.5
MC_MAX_TILT_DEG         35.0
MPC_XY_VEL_MAX          5.0
MPC_Z_VEL_MAX_UP        1.5
MPC_Z_VEL_MAX_DN        1.0
MPC_THR_HOVER           0.50
MPC_LAND_SPEED          0.50

# --- Navigation / RTL -----------------------------------------------------
NAV_ACC_RAD             2.0
NAV_ALT_ERR             3.0
NAV_LOITER_TIME         10.0
RTL_RETURN_ALT          30.0
RTL_DESCEND_ALT         5.0
RTL_CRUISE_SPEED        5.0
RTL_LAND_ENABLE         1

# --- Battery --------------------------------------------------------------
BAT_CELLS               4
BAT_CAPACITY_MAH        5000
BAT_LOW_THR             0.20
BAT_CRIT_THR            0.10
BAT_LOW_VOLT            3.50
BAT_CRIT_VOLT           3.30

# --- Logging --------------------------------------------------------------
LOG_MAX_FILE_MB         256
LOG_ON_ARM              1
